<?xml version="1.0" encoding="utf-8"?>
<!-- 配置接口管理弹窗（0.11.7：手机优先 + 等高对齐）。
     对齐规则：左栏内容区固定 vs_170 —— 与右侧二维码等高同顶；
     因此弹窗总高不随「有无数据」变化，「配置接口」标题永远定在原位。
     左栏 = 列表（点行切换 / 右键进垃圾桶）或空态引导框，二者共用同一块 170 高的区域。
     右栏 = 二维码 + 说明，指向本机 9978 配置页。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_740"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dia_config_title"
            android:textColor="@color/dialog_text_main"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfigTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/dia_config_tip"
            android:textColor="@color/dialog_text_sub"
            android:textSize="@dimen/ts_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:gravity="top"
            android:orientation="horizontal">

            <!-- 左栏：固定 170 高，列表与空态共用这块区域，切换时不改变弹窗高度 -->
            <FrameLayout
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_170"
                android:layout_weight="1">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/listConfig"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_8"
                    app:tv_layoutManager="V7LinearLayoutManager"
                    app:tv_selectedItemIsCentered="false"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_8" />

                <LinearLayout
                    android:id="@+id/llConfigEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_hint_dashed"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/vs_20"
                    android:paddingRight="@dimen/vs_20"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dia_config_empty_title"
                        android:textColor="@color/dialog_text_main"
                        android:textSize="@dimen/ts_15"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_10"
                        android:text="@string/dia_config_empty_step1"
                        android:textColor="@color/dialog_text_sub"
                        android:textSize="@dimen/ts_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:text="@string/dia_config_empty_step2"
                        android:textColor="@color/dialog_text_sub"
                        android:textSize="@dimen/ts_12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vs_4"
                        android:text="@string/dia_config_empty_step3"
                        android:textColor="@color/dialog_text_sub"
                        android:textSize="@dimen/ts_12" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_24"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivConfigQR"
                    android:layout_width="@dimen/vs_170"
                    android:layout_height="@dimen/vs_170"
                    android:background="#FFFFFF"
                    android:contentDescription="@string/dia_config_qr" />

                <TextView
                    android:layout_width="@dimen/vs_180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center"
                    android:lineSpacingExtra="2mm"
                    android:text="@string/dia_config_qr_tip"
                    android:textColor="@color/dialog_text_sub"
                    android:textSize="@dimen/ts_12" />

                <TextView
                    android:id="@+id/tvConfigAddr"
                    android:layout_width="@dimen/vs_180"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_4"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/dialog_hint"
                    android:textSize="@dimen/ts_11" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
