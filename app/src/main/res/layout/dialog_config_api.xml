<?xml version="1.0" encoding="utf-8"?>
<!-- 配置接口管理弹窗（0.11.5 方案：手机优先）。
     左栏 = 配置列表（点行切换 / 右键进垃圾桶删除）；
     右栏 = 二维码，指向本机 9978 的配置页——新增配置一律手机扫码，
     TV 端不再开输入弹窗（两层弹窗套娃 + 遥控器打字都是反人类）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_740"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingTop="@dimen/vs_24"
        android:paddingRight="@dimen/vs_30"
        android:paddingBottom="@dimen/vs_24">

        <LinearLayout
            android:layout_width="@dimen/vs_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dia_config_title"
                android:textColor="@color/dialog_text_main"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:text="@string/dia_config_tip"
                android:textColor="@color/dialog_text_sub"
                android:textSize="@dimen/ts_12" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/listConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_16"
                android:orientation="vertical"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_8"
                app:tv_layoutManager="V7LinearLayoutManager"
                app:tv_selectedItemIsCentered="false"
                app:tv_verticalSpacingWithMargins="@dimen/vs_8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivConfigQR"
                android:layout_width="@dimen/vs_170"
                android:layout_height="@dimen/vs_170"
                android:background="#FFFFFF"
                android:contentDescription="@string/dia_config_qr" />

            <TextView
                android:layout_width="@dimen/vs_180"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/dia_config_qr_tip"
                android:textColor="@color/dialog_text_sub"
                android:textSize="@dimen/ts_12" />

            <TextView
                android:id="@+id/tvConfigAddr"
                android:layout_width="@dimen/vs_180"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/dialog_hint"
                android:textSize="@dimen/ts_11" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
