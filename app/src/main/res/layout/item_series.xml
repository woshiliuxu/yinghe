<?xml version="1.0" encoding="utf-8"?>
<!-- 剧集格（方案 D）：约 86x54，圆角 8。
     宽用 match_parent 交给 GridLayoutManager 等分（12 列，可用宽 1168），
     不写固定宽、也不写 margin —— 行列间距全部由 DetailActivity 的 ItemDecoration 给，
     否则「固定宽 + margin」这种算法在 6 列下必然溢出（首页踩过这个坑）。
     高度 54 是被第二行容器倒推出来的：带分组时网格只剩 178，
     3 × 54 + 2 × 8 = 178 正好；56 的话 3 行要 184，第三行会被挤出去。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/vs_54"
    android:background="@drawable/shape_ep_item"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvSeries"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="@dimen/vs_6"
        android:paddingLeft="@dimen/vs_6"
        android:paddingEnd="@dimen/vs_6"
        android:paddingRight="@dimen/vs_6"
        android:singleLine="true"
        android:textColor="@color/ui_text_2"
        android:textSize="@dimen/ts_18" />
</FrameLayout>
