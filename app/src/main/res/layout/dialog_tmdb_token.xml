<?xml version="1.0" encoding="utf-8"?>
<!-- TMDB 密钥弹窗（0.11.8：方案 A —— 左信息面板 + 右码，与配置接口弹窗同宽同向）。
     已配置 = 左侧浅灰面板装三层信息（徽标行 / 白底等宽掩码 / 时间+说明），右侧二维码；
     未配置 = 面板整块 gone，内容行改居中，只剩一张码 + 一句说明。
     对齐规则：面板与二维码同为 vs_170 高、同顶，底边齐平，弹窗高度两态一致。
     遥控器没法粘贴长 Token，TV 端始终不放输入框。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_740"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg_main"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_30"
    android:paddingTop="@dimen/vs_24"
    android:paddingRight="@dimen/vs_30"
    android:paddingBottom="@dimen/vs_24">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dia_tmdb_title"
        android:textColor="@color/dialog_text_main"
        android:textSize="@dimen/ts_26"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llTmdbBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- 信息面板：与右侧二维码同高（170）、同顶；未配置时整块 gone -->
        <LinearLayout
            android:id="@+id/llTmdbCard"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_170"
            android:layout_weight="1"
            android:background="@drawable/shape_panel_soft"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_20"
            android:paddingTop="@dimen/vs_16"
            android:paddingRight="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_16"
            android:visibility="gone">

            <!-- 第一层：状态徽标 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/vs_8"
                    android:layout_height="@dimen/vs_8"
                    android:background="@drawable/shape_dot_ok" />

                <TextView
                    android:id="@+id/tvTmdbStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:text="@string/dia_tmdb_status_on"
                    android:textColor="@color/dialog_text_main"
                    android:textSize="@dimen/ts_15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTmdbType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:background="@drawable/shape_config_badge"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_2"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_2"
                    android:text="@string/dia_tmdb_type_v4"
                    android:textColor="@color/dialog_text_sub"
                    android:textSize="@dimen/ts_11" />
            </LinearLayout>

            <!-- 第二层：掩码 Token（白底虚线 + 等宽字，像一张凭据） -->
            <TextView
                android:id="@+id/tvTmdbMasked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_14"
                android:background="@drawable/shape_token_box"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:paddingLeft="@dimen/vs_12"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_12"
                android:paddingBottom="@dimen/vs_8"
                android:singleLine="true"
                android:textColor="@color/dialog_text_main"
                android:textSize="@dimen/ts_13" />

            <!-- 第三层：时间 + 操作提示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTmdbTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dialog_hint"
                    android:textSize="@dimen/ts_11" />

                <TextView
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/dia_tmdb_change_tip"
                    android:textColor="@color/dialog_hint"
                    android:textSize="@dimen/ts_11" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右栏：二维码（170，与左面板等高）+ 说明 + 地址 -->
        <LinearLayout
            android:id="@+id/llTmdbRight"
            android:layout_width="@dimen/vs_180"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_24"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTmdbQR"
                android:layout_width="@dimen/vs_170"
                android:layout_height="@dimen/vs_170"
                android:background="#FFFFFF"
                android:contentDescription="@string/dia_config_qr" />

            <TextView
                android:id="@+id/tvTmdbTip"
                android:layout_width="@dimen/vs_180"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:gravity="center"
                android:lineSpacingExtra="2mm"
                android:text="@string/dia_tmdb_empty_tip"
                android:textColor="@color/dialog_text_sub"
                android:textSize="@dimen/ts_12" />

            <TextView
                android:id="@+id/tvTmdbAddr"
                android:layout_width="@dimen/vs_180"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:ellipsize="middle"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/dialog_hint"
                android:textSize="@dimen/ts_11" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
