<?xml version="1.0" encoding="utf-8"?>
<!-- TMDB 密钥弹窗（0.11.5：纯扫码面板）。
     遥控器没法粘贴长 Token，TV 端不再放输入框——二维码扫一下，
     手机配置页里粘贴保存即生效（配置 → 高级选项 → TMDB Token）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_520"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_bg_main"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_24"
    android:paddingTop="@dimen/vs_20"
    android:paddingRight="@dimen/vs_24"
    android:paddingBottom="@dimen/vs_20">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TMDB 密钥"
        android:textColor="@color/dialog_text_main"
        android:textSize="@dimen/ts_20"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivTmdbQR"
        android:layout_width="@dimen/vs_170"
        android:layout_height="@dimen/vs_170"
        android:layout_marginTop="@dimen/vs_16"
        android:background="#FFFFFF"
        android:contentDescription="扫码配置二维码" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_12"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="手机扫码打开配置页 → 高级选项 → TMDB Token，粘贴保存立即生效（不配置 = 首页不显示 TMDB 大图）"
        android:textColor="@color/dialog_text_sub"
        android:textSize="@dimen/ts_15" />

    <TextView
        android:id="@+id/tvTmdbAddr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_4"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/dialog_hint"
        android:textSize="@dimen/ts_11" />

</LinearLayout>
