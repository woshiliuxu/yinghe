<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页「更多」：原来并排的六个等宽按钮里，复制播放地址 / 推送 / 简介三项收进这里。
     播放留在左栏做主按钮，倒序留在右侧线路行（它只跟剧集列表有关），收藏/换源做成图标。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_420"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_menu_panel"
        android:orientation="vertical"
        android:padding="@dimen/vs_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vs_12"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginBottom="@dimen/vs_12"
            android:text="更多"
            android:textColor="@color/ui_text_3"
            android:textSize="@dimen/ts_16" />

        <TextView
            android:id="@+id/menuCopyUrl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:background="@drawable/shape_menu_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vs_16"
            android:paddingLeft="@dimen/vs_16"
            android:paddingEnd="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:text="复制播放地址"
            android:textColor="@color/menu_row_text"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/menuPush"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:layout_marginTop="@dimen/vs_4"
            android:background="@drawable/shape_menu_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vs_16"
            android:paddingLeft="@dimen/vs_16"
            android:paddingEnd="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:text="推送到电视"
            android:textColor="@color/menu_row_text"
            android:textSize="@dimen/ts_24" />

        <TextView
            android:id="@+id/menuDesc"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_60"
            android:layout_marginTop="@dimen/vs_4"
            android:background="@drawable/shape_menu_row"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/vs_16"
            android:paddingLeft="@dimen/vs_16"
            android:paddingEnd="@dimen/vs_16"
            android:paddingRight="@dimen/vs_16"
            android:text="完整简介"
            android:textColor="@color/menu_row_text"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</FrameLayout>
