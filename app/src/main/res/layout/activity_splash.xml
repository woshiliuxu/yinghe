<?xml version="1.0" encoding="utf-8"?>
<!-- 启动页：纯黑底 + 正中的圆 + 下方的进度条。
     圆直径 190，圆心正好落在 (640, 360)；进度条 178×4 距底 86；应用名距底 6。
     这里不是装饰动画 —— 进度条接的是 ApiConfig 的真实加载回调，
     配置和 spider 都就绪之后才进主界面。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <LinearLayout
        android:id="@+id/splashCircle"
        android:layout_width="@dimen/vs_190"
        android:layout_height="@dimen/vs_190"
        android:background="@drawable/shape_splash_circle"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/vs_96"
            android:layout_height="@dimen/vs_96"
            android:src="@drawable/splash_mark" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashBar"
        android:layout_width="@dimen/vs_178"
        android:layout_height="4mm"
        android:layout_marginBottom="@dimen/vs_86"
        android:background="@drawable/shape_splash_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:id="@+id/splashBarFill"
            android:layout_width="0mm"
            android:layout_height="match_parent"
            android:background="@drawable/shape_splash_bar_fill" />
    </FrameLayout>

    <TextView
        android:id="@+id/splashName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vs_6"
        android:alpha="0"
        android:text="@string/app_name"
        android:textColor="@color/ui_text_2"
        android:letterSpacing="0.12"
        android:textSize="@dimen/ts_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/splashHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vs_8"
        android:alpha="0"
        android:text="正在加载接口配置"
        android:textColor="@color/ui_text_3"
        android:textSize="@dimen/ts_16"
        app:layout_constraintBottom_toTopOf="@+id/splashBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
