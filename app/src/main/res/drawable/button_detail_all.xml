<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页功能按钮（播放/收藏/推送/筛选…）：玻璃按钮。
     常态 8% 白底 + 1px 描边，焦点 20% 白底 + 2mm 白描边。
     文字保持白色，所以不能用白色实底（会白字白底）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="#33FFFFFF" />
            <stroke
                android:width="2mm"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1mm"
                android:color="@color/ui_glass_border" />
        </shape>
    </item>
</selector>
