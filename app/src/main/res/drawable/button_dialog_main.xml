<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗行/按钮（2026-11-05 第二版：亮面板反色焦点）。
     面板已是暖白，常态=无底透明（行与面板同色），聚焦翻深色实底。
     行内文字必须用 @color/dialog_row_text：常态深字、聚焦翻浅字，
     否则深底深字（亮面板时代的新坑）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#14161A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#2E14161A" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#0A14161A" />
        </shape>
    </item>
</selector>
