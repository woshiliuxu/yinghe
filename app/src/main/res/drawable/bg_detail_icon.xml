<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页圆形图标按钮（收藏 / 换源 / 更多）：56 直径，圆角直接给 28 就是正圆。
     焦点态用 2mm 暖白描边 + 底色提亮，跟左侧播放键形成两种焦点表现（实心 vs 描边）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#2EF4F1EA" />
            <stroke
                android:width="2mm"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#0FFFFFFF" />
            <stroke
                android:width="1mm"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
