<?xml version="1.0" encoding="utf-8"?>
<!-- 通用可点条目（搜索/设置/历史/收藏/对话框列表都用它）
     纯白主色下，焦点用「白描边 + 20% 白底」表达，不用白色实底——
     否则条目里的白字会直接被底色吃掉。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="#2EFFFFFF" />
            <stroke
                android:width="@dimen/vs_2"
                android:color="@color/ui_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1mm"
                android:color="@color/ui_glass_border" />
        </shape>
    </item>
</selector>
