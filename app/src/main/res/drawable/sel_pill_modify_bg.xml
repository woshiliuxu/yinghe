<?xml version="1.0" encoding="utf-8"?>
<!-- 「修改」胶囊：常态亮玻璃，聚焦暖白 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_8" />
            <solid android:color="#F4F1EA" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_8" />
            <solid android:color="#24F4F1EA" />
            <stroke android:width="1mm" android:color="#38F4F1EA" />
        </shape>
    </item>
</selector>
