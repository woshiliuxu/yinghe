<?xml version="1.0" encoding="utf-8"?>
<!-- 剧集格（96x64 圆角 12）：
     常态极淡白底 + 1px 描边；焦点整块翻成暖白实底（文字同时变深色，由适配器换 textColor）；
     「当前正在播的这一集」不靠背景区分，靠文字色（暖白），避免和焦点态混淆。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#F4F1EA" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#1FFFFFFF" />
            <stroke
                android:width="1mm"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
