<?xml version="1.0" encoding="utf-8"?>
<!-- 详情页「更多」菜单底板：不透明深色 + 圆角 22。
     用不透明而不是玻璃：菜单浮在模糊海报上，半透明会让字和底下的剧情简介糊在一起。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="@dimen/vs_22" />
    <solid android:color="#F2181A1F" />
    <stroke
        android:width="1mm"
        android:color="#2EFFFFFF" />
</shape>
