<?xml version="1.0" encoding="utf-8"?>
<!-- 右上角切换器小图的底与焦点框。
     焦点 = 亮底 + 2mm 白描边（描边在 background 里，clipToOutline 才能跟着圆角走）；
     常态 = 半透明灰底，让没选中的封面退后。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#3A4256" />
                    <stroke android:width="2dp" android:color="#F2EFE8" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#2BFFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
