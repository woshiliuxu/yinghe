<?xml version="1.0" encoding="utf-8"?>
<!-- 海报占位图上的品牌标记：细框当"盒"，实心三角当"影"，与启动图标同一个记号。
     尺寸刻意压到 30dp：占位图是塞在 144×216 的卡片里的，
     原来那个 250dp 的图标在卡片里会被裁掉大半圈，只剩中间一团黑 —— 这才是"占位图难看"的真正原因。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 盒：圆角方框 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M7,1.8 L17,1.8 A5.2,5.2 0 0 1 22.2,7 L22.2,17 A5.2,5.2 0 0 1 17,22.2 L7,22.2 A5.2,5.2 0 0 1 1.8,17 L1.8,7 A5.2,5.2 0 0 1 7,1.8 Z"
        android:strokeAlpha="0.22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5" />

    <!-- 影：实心播放三角（顶点略偏右，光学居中） -->
    <path
        android:fillAlpha="0.22"
        android:fillColor="#FFFFFF"
        android:pathData="M9.9,7.9 L16.6,11.6 C17,11.8 17,12.2 16.6,12.4 L9.9,16.1 C9.5,16.3 9,16 9,15.6 L9,8.4 C9,8 9.5,7.7 9.9,7.9 Z" />
</vector>
