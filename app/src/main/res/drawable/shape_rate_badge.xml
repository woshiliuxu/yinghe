<?xml version="1.0" encoding="utf-8"?>
<!-- 豆瓣评分角标：左上角小胶囊，黑底半透明 + 白字。
     豆瓣推荐页每张海报都显示，因为是唯一能区分「为什么推荐这部」的信息。
     不用纯白底：纯白压在亮海报上会糊成一片，深色底反而更稳。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0B0C0F" />
    <corners android:radius="@dimen/vs_8" />
    <stroke
        android:width="1px"
        android:color="#33FFFFFF" />
</shape>
