<?xml version="1.0" encoding="utf-8"?>
<!-- v21 版本会覆盖同名默认资源（layout-v21 踩过的坑在 drawable 重演），
     必须与 drawable/button_dialog_main.xml 保持完全一致。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#14161A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#2E14161A" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="#0A14161A" />
        </shape>
    </item>
</selector>
